// This file is auto-generated by Prisma CLI.
// datasource and generator are already configured.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  avatarColor  String   @default("#7C3AED")
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  groupMemberships GroupMember[]
  billsPaid        Bill[]          @relation("BillPayer")
  itemAssignments  ItemAssignment[]
  paymentsMade     Payment[]       @relation("PaymentFrom")
  paymentsReceived Payment[]       @relation("PaymentTo")
  reminders        Reminder[]
  aiConversations  AIConversation[]
  notifiedReminders Reminder[]     @relation("ReminderTarget")

  @@map("users")
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String   @default("other")
  emoji       String   @default("👥")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members      GroupMember[]
  bills        Bill[]
  settlements  Settlement[]

  @@map("groups")
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  role     String   @default("member") // admin | member
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@map("group_members")
}

model Bill {
  id             String   @id @default(cuid())
  groupId        String
  payerId        String
  title          String
  description    String?
  category       String   @default("restaurant")
  imageUrl       String?
  rawOcrText     String?
  subtotal       String   @default("0") // stored as string for precision
  tax            String   @default("0")
  serviceCharge  String   @default("0")
  tip            String   @default("0")
  discount       String   @default("0")
  total          String   @default("0")
  date           DateTime @default(now())
  isSettled      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  group Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  payer User   @relation("BillPayer", fields: [payerId], references: [id])
  items BillItem[]
  payments Payment[]

  @@map("bills")
}

model BillItem {
  id          String   @id @default(cuid())
  billId      String
  name        String
  quantity    Int      @default(1)
  price       String   // per unit, as string for precision
  totalPrice  String   // quantity * price, as string
  createdAt   DateTime @default(now())

  bill        Bill             @relation(fields: [billId], references: [id], onDelete: Cascade)
  assignments ItemAssignment[]

  @@map("bill_items")
}

model ItemAssignment {
  id         String   @id @default(cuid())
  billItemId String
  userId     String
  share      String   @default("1") // fractional share (e.g. 0.5 for half)
  amount     String   // actual amount assigned
  createdAt  DateTime @default(now())

  billItem BillItem @relation(fields: [billItemId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([billItemId, userId])
  @@map("item_assignments")
}

model Payment {
  id        String   @id @default(cuid())
  billId    String?
  groupId   String?
  fromId    String
  toId      String
  amount    String
  note      String?
  method    String   @default("other") // upi | cash | other
  createdAt DateTime @default(now())

  bill Bill? @relation(fields: [billId], references: [id])
  from User  @relation("PaymentFrom", fields: [fromId], references: [id])
  to   User  @relation("PaymentTo", fields: [toId], references: [id])

  @@map("payments")
}

model Settlement {
  id          String   @id @default(cuid())
  groupId     String
  calculatedAt DateTime @default(now())
  isActive    Boolean  @default(true)

  group        Group                  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  transactions SettlementTransaction[]

  @@map("settlements")
}

model SettlementTransaction {
  id           String   @id @default(cuid())
  settlementId String
  fromId       String
  toId         String
  amount       String
  isCompleted  Boolean  @default(false)
  completedAt  DateTime?
  createdAt    DateTime @default(now())

  settlement Settlement @relation(fields: [settlementId], references: [id], onDelete: Cascade)

  @@map("settlement_transactions")
}

model Reminder {
  id         String   @id @default(cuid())
  creatorId  String
  targetId   String
  message    String
  context    String?  // JSON: { billId, amount, groupId }
  status     String   @default("pending") // pending | sent | cancelled
  sentAt     DateTime?
  createdAt  DateTime @default(now())

  creator User @relation(fields: [creatorId], references: [id])
  target  User @relation("ReminderTarget", fields: [targetId], references: [id])

  @@map("reminders")
}

model AIConversation {
  id        String   @id @default(cuid())
  userId    String
  groupId   String?
  billId    String?
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User        @relation(fields: [userId], references: [id])
  messages AIMessage[]

  @@map("ai_conversations")
}

model AIMessage {
  id             String   @id @default(cuid())
  conversationId String
  role           String   // user | assistant
  content        String
  action         String?  // JSON: { type, data } - structured action from AI
  createdAt      DateTime @default(now())

  conversation AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@map("ai_messages")
}
